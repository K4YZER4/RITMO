# Entorno de ejecución de la aplicación.
# Valores permitidos por el schema: development, test, production.
NODE_ENV=development

# Puerto local donde NestJS escuchará las peticiones HTTP.
PORT=3000

# URL de conexión usada por Prisma en tiempo de ejecución.
# Sustituye USER, PASSWORD, HOST y DATABASE por los datos de tu proveedor.
# Nunca subas credenciales reales al repositorio.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# URL de conexión directa usada por Prisma para migraciones y operaciones que
# no deben pasar por un pooler/pgBouncer. En Neon normalmente corresponde al host directo.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secreto usado para firmar y verificar JWT.
# Genera uno aleatorio de al menos 32 caracteres; por ejemplo:
# openssl rand -base64 48
# No uses este valor de ejemplo en producción.
JWT_SECRET="replace_with_a_random_secret_of_at_least_32_characters"

# Duración del JWT en segundos. 86400 equivale a 24 horas.
JWT_EXPIRATION_TIME=86400

# Ventana de tiempo del rate limit en milisegundos.
# 10000 equivale a 10 segundos.
RATE_LIMIT_TTL=10000

# Máximo de peticiones por IP dentro de RATE_LIMIT_TTL para endpoints generales.
RATE_LIMIT_GLOBAL_LIMIT=30