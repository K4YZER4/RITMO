# Copia este archivo a test/.env.test y ajusta los valores.
# test/.env.test esta en .gitignore: NO debe subirse al repositorio.
# Las validaciones vienen de src/config/env.schema.ts.

# NODE_ENV no se sobreescribe en schema (solo define default); setup-env.js lo fuerza a "test".
NODE_ENV=test

# Confirmación obligatoria para permitir que los E2E ejecuten TRUNCATE ... CASCADE.
E2E_ALLOW_DATABASE_RESET=true

PORT=3000

# BASE DE DATOS DE TEST. NO uses la de desarrollo ni la de produccion.
# Crea una base dedicada (ej. branch en Neon o Postgres local) y aplica las migraciones:
#   pnpm prisma migrate deploy
# Las migraciones incluyen el seed de catalogos (planes, sexo, objetivo, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE_TEST?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE_TEST?sslmode=require"

# Secreto JWT de al menos 32 caracteres.
JWT_SECRET="replace_with_a_random_secret_of_at_least_32_characters"
JWT_EXPIRATION_TIME=86400

# Rate limit (TTL en ms). En e2e el ThrottlerGuard se neutraliza, pero el schema lo valida.
RATE_LIMIT_TTL=10000
RATE_LIMIT_GLOBAL_LIMIT=30

# MODO TEST DE STRIPE. Debe iniciar con sk_test_.
STRIPE_SECRET_KEY="sk_test_..."
# Debe iniciar con whsec_. Usa el siguiente comando para obtenerlo:
#   stripe listen --api-key sk_test_... --forward-to localhost:3003/pagos/webhook/stripe --skip-verify
STRIPE_WEBHOOK_SECRET="whsec_..."

# URL valida (se usa en los emails/callbacks de checkout).
FRONTEND_URL="http://localhost:3001"
